# --- Supabase (required) ---------------------------------------------------
# Project URL and anon (publishable) key: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER-SIDE ONLY. Needed only for the demo seed script
# (npm run seed:demo). Never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App -------------------------------------------------------------------
# Public base URL of the deployment (used for auth email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI suggestions (optional, Phase 2) ------------------------------------
# When unset, the app shows "AI suggestions unavailable" and reports are
# completed manually. No AI analysis is ever claimed without a real call.
ANTHROPIC_API_KEY=
